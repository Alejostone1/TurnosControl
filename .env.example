# ============================================================
# CONFIGURACIÓN DE ENTORNO - EJEMPLO
# Copia este archivo como .env y rellena los valores reales
# ============================================================

NODE_ENV=development
PORT=3000
APP_NAME="Sistema Calculo Turnos"

# -------------------------
# BASE DE DATOS POSTGRESQL
# -------------------------
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_DB"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=turnos_db
DB_USER=USUARIO
DB_PASSWORD=PASSWORD

# -------------------------
# Redis (Bull / Cache)
# Opcional — sin Redis la app funciona en modo síncrono
# -------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------
# NEXTAUTH
# Genera el secreto con: openssl rand -base64 32
# -------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=SECRETO_ALEATORIO_MINIMO_32_CHARS
AUTH_SECRET=SECRETO_ALEATORIO_MINIMO_32_CHARS
AUTH_URL=http://localhost:3000

# -------------------------
# JWT (SEGURIDAD)
# -------------------------
JWT_SECRET=SECRETO_JWT_ALEATORIO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=SECRETO_REFRESH_ALEATORIO
JWT_REFRESH_EXPIRES_IN=7d

# -------------------------
# BCRYPT
# -------------------------
BCRYPT_ROUNDS=12

# -------------------------
# RATE LIMITING
# -------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# -------------------------
# LOGS
# -------------------------
LOG_LEVEL=debug
LOG_DIR=./logs

# -------------------------
# SWAGGER (DOCUMENTACIÓN API)
# -------------------------
SWAGGER_TITLE="API Sistema Turnos"
SWAGGER_DESCRIPTION="Documentacion backend sistema de calculo de turnos"
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# -------------------------
# CORS
# -------------------------
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_CREDENTIALS=true

# -------------------------
# ENTORNO FUTURO (SaaS)
# -------------------------
APP_URL=http://localhost:3000
SHADOW_DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_DB?schema=public"
