# ============================================================
# VARIABLES DE ENTORNO PARA PRODUCCION (Vercel)
# Copialas en: Vercel Dashboard -> Project -> Settings -> Environment Variables
# NO subas este archivo con valores reales. Solo plantilla.
# ============================================================

# -----------------------------------------------------------
# BASE DE DATOS (Neon - PostgreSQL serverless)
# Connection string que copias desde console.neon.tech
# Marca "Pooled connection" para serverless.
# -----------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------
# NEXTAUTH (autenticacion)
# Genera el secreto con:  openssl rand -base64 32
# -----------------------------------------------------------
NEXTAUTH_URL="https://tu-app.vercel.app"
NEXTAUTH_SECRET="GENERA_UN_SECRETO_DE_AL_MENOS_32_CARACTERES"
AUTH_SECRET="GENERA_UN_SECRETO_DE_AL_MENOS_32_CARACTERES"
AUTH_URL="https://tu-app.vercel.app"

# -----------------------------------------------------------
# JWT
# -----------------------------------------------------------
JWT_SECRET="SECRETO_JWT_ALEATORIO"
JWT_REFRESH_SECRET="SECRETO_REFRESH_ALEATORIO"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------
# BCRYPT
# -----------------------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------------------
# APP
# -----------------------------------------------------------
APP_NAME="Sistema Calculo Turnos"
APP_URL="https://tu-app.vercel.app"
CORS_ORIGIN="https://tu-app.vercel.app"
CORS_METHODS="GET,HEAD,PUT,PATCH,POST,DELETE"
CORS_CREDENTIALS=true

# -----------------------------------------------------------
# REDIS (OPCIONAL)
# Vercel no incluye Redis. Si NO la configuras, el calculo de
# nomina se ejecutara de forma sincrona en la misma request.
# Para produccion con colas, usa Upstash Redis (free tier):
#   https://console.upstash.com/redis
# -----------------------------------------------------------
# REDIS_URL="rediss://default:PASSWORD@xxxx.upstash.io:6379"
